<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <Version>0.0.6</Version>
    <InformationalVersion>0.0.6-beta</InformationalVersion>
    <AssemblyName>ZSnaper.FullInstaller</AssemblyName>
    <RootNamespace>ZSnaper.FullInstaller</RootNamespace>
    <ApplicationIcon>..\..\..\assets\logo\ZSnaper.ico</ApplicationIcon>
    <AvaloniaUseCompiledBindingsByDefault>false</AvaloniaUseCompiledBindingsByDefault>
    <PublishTrimmed>false</PublishTrimmed>
    <BuiltInComInteropSupport>true</BuiltInComInteropSupport>
    <NoWarn>$(NoWarn);CS9057</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Avalonia.Desktop" Version="12.1.1" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="12.1.1" />
    <ProjectReference Include="..\ZSnaper.Installer.Core\ZSnaper.Installer.Core.csproj" />
    <AvaloniaResource Include="..\..\..\assets\logo\ZSnaper.ico" Link="Assets\ZSnaper.ico" />
  </ItemGroup>
  <ItemGroup>
    <Compile Remove="InstallerControls.cs" />
    <Compile Remove="InstallerForm.cs" />
  </ItemGroup>
</Project>
