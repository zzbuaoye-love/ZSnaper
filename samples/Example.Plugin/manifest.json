{
  "manifestVersion": 1,
  "id": "example.plugin",
  "name": "Example Plugin",
  "description": "演示截图事件、插件动作和保存截图。",
  "version": "1.1.0",
  "entry": {
    "assembly": "Example.Plugin.dll",
    "type": "Example.Plugin.ExamplePlugin"
  },
  "scope": {
    "type": "app",
    "events": ["capture.completed"],
    "runAt": "event"
  },
  "requires": {
    "hostApis": ["capture", "toolbar", "logger"],
    "pluginApi": ">=1.0.0 <2.0.0",
    "appVersion": ">=0.0.5"
  }
}
